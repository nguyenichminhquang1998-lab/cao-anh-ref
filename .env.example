# Thu muc luu anh moodboard + index SQLite. Mac dinh: ~/Pictures/cao-anh-ref
CAO_ANH_REF_ROOT=

# Duong dan file SQLite index (mac dinh: <root>/index.sqlite3)
CAO_ANH_REF_DB=

# Duong dan luu Pinterest session sau khi dang nhap (mac dinh: <root>/pinterest_storage_state.json)
CAO_ANH_REF_PINTEREST_STATE=

# So giay cho toi thieu giua 2 request lien tiep toi nguon anh (rate limit)
CAO_ANH_REF_REQUEST_DELAY_SECONDS=3.0

# So ket qua mac dinh moi lan search neu khong truyen limit
CAO_ANH_REF_DEFAULT_SEARCH_LIMIT=20
